# Провайдер LLM: 'openai' (и OpenAI-совместимые) или 'yandex' (YandexGPT)
# LLM_PROVIDER=openai

# Ключ OpenAI (получить: https://platform.openai.com/api-keys)
# Можно оставить пустым и ввести ключ в интерфейсе приложения.
OPENAI_API_KEY=

# Base URL OpenAI-совместимого API (для других провайдеров, например Groq / OpenRouter / DeepSeek)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Модели по умолчанию (можно менять в интерфейсе)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- YandexGPT (если LLM_PROVIDER=yandex) ---
# Yandex Folder ID (обязателен) — из облачной консоли Yandex Cloud
# YANDEX_FOLDER_ID=
# Chat-модель YandexGPT (yandexgpt-lite / yandexgpt / yandexgpt-pro / yandexgpt-32k)
# OPENAI_CHAT_MODEL=yandexgpt-lite
# Embedding-модель Yandex (text-search-doc / text-search-query)
# OPENAI_EMBEDDING_MODEL=text-search-doc
# API-ключ Yandex Cloud (сервисный аккаунт) — можно ввести в интерфейсе
# OPENAI_API_KEY=

# Порт, на котором будет слушать бэкенд
PORT=3000